{
  "code": "hy",
  "phrases": {
    "hello": {
      "text": "Բարև ձեզ",
      "roman": "Barev dzez",
      "note": "To friends, just Բարև (barev). Also common: Ողջույն (voghjuyn)."
    },
    "goodbye": {
      "text": "Ցտեսություն",
      "roman": "Tstesutyun",
      "note": "Casual and very common: Հաջող (hajogh)."
    },
    "please": {
      "text": "Խնդրում եմ",
      "roman": "Khndrum em",
      "note": "The kh sounds like the ch in Scottish 'loch'."
    },
    "thank_you": {
      "text": "Շնորհակալություն",
      "roman": "Shnorhakalutyun",
      "note": "Everyday: Մերսի (mersi). Very warmly: Շատ շնորհակալ եմ (shat shnorhakal em)."
    },
    "youre_welcome": {
      "text": "Խնդրեմ",
      "roman": "Khndrem",
      "note": "Also common: Չարժե (charzhe), 'don't mention it'."
    },
    "yes": {
      "text": "Այո",
      "roman": "Ayo",
      "note": "Everyday: Հա (ha)."
    },
    "no": {
      "text": "Ոչ",
      "roman": "Voch",
      "note": "Everyday: Չէ (che)."
    },
    "sorry": {
      "text": "Ներողություն",
      "roman": "Neroghutyun",
      "note": "Also: Ներեցեք (neretsek). To a friend: Ներիր (nerir)."
    },
    "excuse_me": {
      "text": "Կներեք",
      "roman": "Knerek",
      "note": "Ներողություն (neroghutyun) is also used to get someone's attention."
    },
    "good_morning": {
      "text": "Բարի լույս",
      "roman": "Bari luys"
    },
    "how_are_you": {
      "text": "Ինչպե՞ս եք",
      "roman": "Inchpes ek?",
      "note": "Everyday: Ո՞նց եք (vonts ek?). To a friend: Ո՞նց ես (vonts es?)."
    },
    "im_fine": {
      "text": "Լավ եմ, շնորհակալություն",
      "roman": "Lav em, shnorhakalutyun",
      "note": "Shorter: Լավ եմ, մերսի (lav em, mersi)."
    },
    "whats_your_name": {
      "text": "Ձեր անունն ի՞նչ է",
      "roman": "Dzer anunn inch e?",
      "note": "To a friend or a child: Անունդ ի՞նչ է (anund inch e?)."
    },
    "my_name_is": {
      "text": "Իմ անունը … է",
      "roman": "Im anuny … e",
      "note": "Everyday: Անունս … է (anuns … e)."
    },
    "nice_to_meet_you": {
      "text": "Շատ հաճելի է",
      "roman": "Shat hacheli e",
      "note": "Also: Ուրախ եմ ծանոթանալու համար (urakh em tsanotanalu hamar)."
    },
    "where_from": {
      "text": "Որտեղի՞ց եք",
      "roman": "Vorteghits ek?",
      "note": "To a friend: Որտեղի՞ց ես (vorteghits es?)."
    },
    "im_from": {
      "text": "Ես …-ից եմ",
      "roman": "Yes …-its em",
      "note": "The ending -ից (-its) joins the country: Ֆրանսիայից (Fransiayits), from France."
    },
    "speak_english": {
      "text": "Դուք անգլերեն խոսո՞ւմ եք",
      "roman": "Duk angleren khosum ek?",
      "note": "Also very common: Անգլերեն գիտե՞ք (angleren gitek?)."
    },
    "dont_understand": {
      "text": "Չեմ հասկանում",
